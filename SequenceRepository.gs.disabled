/**
 * ==========================================================
 * Sequence Repository
 * Enterprise Foundation v1.0
 * ==========================================================
 */

class SequenceRepository extends BaseRepository {

  constructor() {

    super(SHEET.SEQUENCES);

  }

  next(sequenceName) {

    const record = this.findBy("Module", sequenceName);

    if (!record) {

      this.insert({

        Module: sequenceName,

        CurrentNumber: 1

      });

      return 1;

    }

    const nextValue =
      Number(record.CurrentNumber) + 1;

    const headers = this.getHeaders();

    const data = this.getAll();

    const rowIndex =
      data.findIndex(r => r.Module === sequenceName);

    this.sheet
      .getRange(
        rowIndex + 2,
        headers.indexOf("CurrentNumber") + 1
      )
      .setValue(nextValue);

    return nextValue;

  }

}